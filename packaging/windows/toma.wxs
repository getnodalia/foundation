<?xml version="1.0" encoding="utf-8"?>
<!--
  Toma MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build toma.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Toma"
      Manufacturer="Nodalia"
      Version="$(var.Version)"
      UpgradeCode="91AEDAB0-A090-4A19-9E97-4B7D2BCBDF6B"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Toma video editor" Manufacturer="Nodalia" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Toma is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="TomaIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TomaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getnodalia.com/toma" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getnodalia.com/toma" />
    <Property Id="ARPHELPLINK" Value="https://github.com/getnodalia/toma/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Toma" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Toma" Level="1">
      <ComponentGroupRef Id="TomaFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="TomaFiles" Directory="INSTALLFOLDER">
      <Component Id="TomaApp" Guid="BC84DA01-4D9E-43C5-AA66-42B858CE69E4">
        <File Id="TomaExe" Source="$(var.BinDir)\toma.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Toma"
              Description="Toma video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="TomaIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\toma.exe" Value="[#TomaExe]" Type="string" />
      </Component>

      <Component Id="TomaCli">
        <File Id="TomaCliExe" Source="$(var.BinDir)\toma-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
